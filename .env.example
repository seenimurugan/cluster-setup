# ---------------------------------------------------------------------------
# cluster-setup — environment variables
# Copy this file to .env, fill in real values, then run ./deploy.sh
# ---------------------------------------------------------------------------

# ── External HDD (exFAT, plug-in disk) ──────────────────────────────────────
# The hostPath for jellyfin + immich PVs. Must exist on this Mac BEFORE
# deploy.sh runs (deploy.sh creates the per-app subfolders inside it).
HOMELAB_HDD_PATH=/Volumes/Seeni's HDD

# ── Tiered-storage HDD (HFS+ — secondary disk used by tier-mover) ───────────
# Optional. Only required if you plan to use docs/storage-tier/ to spill
# large files from the OrbStack SSD onto a second HDD. Leave the default
# if you don't have a second HDD plugged in; the tier-mover CronJobs ship
# suspended (suspend: true) so they won't actually run.
HOMELAB_TIER_HDD_PATH=/Volumes/homelab-hdd

# ── Local SSD ────────────────────────────────────────────────────────────────
# Where the k3s local-path PVs live (inside the OrbStack VM, then on APFS).
# Used by Postgres / metadata stores. Default is $HOME/homelab-data but k3s
# manages this automatically under /var/lib/rancher/k3s/storage inside the VM,
# so this value is informational unless you customize a PV.
HOMELAB_LOCAL_DATA=$HOME/homelab-data

# ── Kubernetes ──────────────────────────────────────────────────────────────
# Namespace where most homelab apps live.
HOMELAB_NAMESPACE=homelab

# ── User / host ─────────────────────────────────────────────────────────────
# Used by LaunchAgent plist templates and refresh-localhost.sh.
# Defaults from your shell if left unset.
USER_HOME=$HOME
USER_NAME=$USER

# ── Tooling overrides (optional) ────────────────────────────────────────────
# Uncomment to override the autodetected binaries.
# KUBECTL_BIN=/opt/homebrew/bin/kubectl
# ZSTD_BIN=/opt/homebrew/bin/zstd
# TAILSCALE_BIN=/Applications/Tailscale.app/Contents/MacOS/Tailscale

# ── Tailscale ───────────────────────────────────────────────────────────────
# cluster-setup does NOT install the Tailscale operator — that's a separate
# tailscale-operator app, deployed second. Set TAILSCALE_AUTH_KEY there.
# (Documented here only so devs grep the repo and find the breadcrumb.)
# TAILSCALE_AUTH_KEY=set-in-the-tailscale-operator-app
