<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template — processed by ../deploy.sh via envsubst.
  After templating, this file is written to:
    ${USER_HOME}/Library/LaunchAgents/com.${USER_NAME}.homelab-localhost.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.${USER_NAME}.homelab-localhost</string>

    <key>ProgramArguments</key>
    <array>
        <string>${CLUSTER_SETUP_DIR}/scripts/localhost-portforward.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>${CLUSTER_SETUP_DIR}/scripts/localhost-portforward.out.log</string>

    <key>StandardErrorPath</key>
    <string>${CLUSTER_SETUP_DIR}/scripts/localhost-portforward.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>KUBECONFIG</key>
        <string>${USER_HOME}/.kube/config</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>${CLUSTER_SETUP_DIR}</string>
</dict>
</plist>
